{
  "plugins": ["@ianvs/prettier-plugin-sort-imports"],
  "singleQuote": false,
  "jsxSingleQuote": false,
  "tabWidth": 2,
  "semi": true,
  "printWidth": 120,
  "bracketSpacing": true,
  "bracketSameLine": false,
  "arrowParens": "avoid",
  "importOrderSeparation": true,
  "importOrder": [
    "^react$",
    "^react-native$",
    "^expo$",
    "^expo-",
    "^expo/",
    "<THIRD_PARTY_MODULES>",
    "",
    "^@/src/providers",
    "^@/src/constants",
    "^@/src/types",
    "^@/src/utils",
    "^@/src/components/primitives",
    "^@/src/components/ui",
    "^@/src/components",
    "^@/src",
    "",
    "^\\.\\.(?!/?$)",
    "^\\.\\./?$",
    "^\\./(?=.*/)(?!/?$)",
    "^\\.(?!/?$)",
    "^\\./?$"
  ]
}
